# Plantilla de variables. Cópiala a .env para probar en tu ordenador; en Render se ponen en "Environment".
# Los valores reales NUNCA se suben al repo (.env está en .gitignore). Guía completa: docs/INSTALACION.md

# ─── Obligatorias ────────────────────────────────────────────────────────────

# Base de datos. Neon → tu proyecto → Connect → "Connection string" (empieza por postgresql://).
# En tu ordenador, con un Postgres local sin SSL, termina la dirección en ?sslmode=disable
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx.neon.tech/neondb?sslmode=require

# Clave para crear la primera cuenta de admin en la web (/app). Mínimo 12 caracteres.
ADMIN_PASSWORD=pon-una-contraseña-larga

# Texto que inventas tú; el mismo lo pegas en Meta → Webhooks → "Verify token".
WEBHOOK_VERIFY_TOKEN=un-texto-largo-aleatorio

# ─── Instagram (Meta for Developers) ────────────────────────────────────────

# Meta → tu app → Instagram → "Instagram app secret". Sin él no se aceptan los avisos de Meta.
META_APP_SECRET=
# Opcional: App Secret de la app de Facebook (Configuración → Básica), por si Meta firma con ese.
META_APP_SECRET_ALT=

# Meta → tu app → Instagram → "Generate access tokens" para tu cuenta.
IG_ACCESS_TOKEN=
IG_API_VERSION=v25.0

# Opcional: "Instagram app ID" (Meta → tu app → Instagram). Activa el botón "Conectar Instagram" de la web.
INSTAGRAM_APP_ID=

# Clave para guardar CIFRADO el token renovado y firmar los enlaces con seguimiento (mínimo 16 caracteres).
TOKEN_ENCRYPTION_KEY=

# Dirección pública del servidor (https://…). En Render no hace falta: la pone sola (RENDER_EXTERNAL_URL).
PUBLIC_BASE_URL=

# ─── Setter con IA (Anthropic) ──────────────────────────────────────────────

# console.anthropic.com → API Keys. Sin ella los DMs se guardan, pero la IA no responde.
ANTHROPIC_API_KEY=
# Opcional: modelo del setter (por defecto claude-haiku-5-5).
SETTER_MODEL=

# Opcional: enlaces del setter. Mejor ponlos en la web (Setter IA → Modo → Tus enlaces).
SETTER_LINK_AGENDA=
SETTER_LINK_MEMBERSHIP=
SETTER_CONTACT_EMAIL=

# ─── Anti-ban (opcional) ────────────────────────────────────────────────────

# Envíos máximos por hora y espera aleatoria entre envíos (milisegundos).
SEND_LIMIT_PRIVATE_PER_HOUR=700
SEND_LIMIT_PUBLIC_PER_HOUR=700
SEND_LIMIT_FOLLOWUP_PER_HOUR=3000
SEND_DELAY_COMMENT_MIN_MS=1000
SEND_DELAY_COMMENT_MAX_MS=2000
SEND_DELAY_FOLLOWUP_MIN_MS=300
SEND_DELAY_FOLLOWUP_MAX_MS=800

# Puerto local (Render pone el suyo).
PORT=3000
